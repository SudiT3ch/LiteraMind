# Copy to .env and fill in. NEVER commit .env.
# LLM provider: heuristic (no key, rule-based fallback) | anthropic | openai | ollama
LLM_PROVIDER=heuristic
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OLLAMA_URL=http://localhost:11434
# Academic APIs (keys optional; Semantic Scholar works unauthenticated with low rate limits)
S2_API_KEY=
CONTACT_EMAIL=you@example.com
ENABLED_SOURCES=arxiv,semantic_scholar,openalex
# Embeddings: auto | sentence-transformers | hashing
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DATABASE_URL=sqlite:///data/literamind.db
BACKEND_URL=http://127.0.0.1:8000
MAX_UPLOAD_MB=25
MAX_PAPERS=8
LOG_LEVEL=INFO
